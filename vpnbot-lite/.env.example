# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Адрес сервера в ключах (IP или домен). Пусто — определится автоматически.
SERVER_HOST=
# Порты: VLESS Reality (TCP), VLESS XHTTP (TCP, 0 — выключить), Hysteria2 (UDP), AmneziaWG (UDP), подписки (TCP)
XRAY_PORT=443
XHTTP_PORT=8443
HY2_PORT=443
AWG_PORT=51820
SUB_PORT=2096
# MTProto-прокси для Telegram (0 — выключен: такие прокси ищут и блокируют, они «подсвечивают» IP сервера)
MTPROTO_PORT=0
# AmneziaWG: внутренняя подсеть туннеля и DNS для клиентов
AWG_SUBNET=10.66.66.0/24
AWG_DNS=1.1.1.1, 8.8.8.8
# Если подписки отдаются через свой домен/обратный прокси, например https://sub.example.com
SUB_URL=

# Откуда бот узнаёт о новой версии самого себя (файл VERSION в git-репозитории)
BOT_VERSION_URL=

TZ=Europe/Moscow
